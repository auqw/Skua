<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sharedShell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        x:Class="Skua.Manager.Avalonia.Views.MainWindow"
        Classes="skua"
        d:DesignWidth="800"
        d:DesignHeight="500"
        Title="{Binding Title}"
        Width="800"
        Height="500"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Skua.Shared.Avalonia/Assets/SkuaIcon.ico"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="32">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <sharedShell:WindowTitleBar Grid.Row="0"
                                    x:Name="TitleBar"
                                    TitleText="{Binding Title}" />

        <!-- Tab Navigation -->
        <DockPanel Grid.Row="1"
                   Height="30"
                   Margin="4,4,4,1">
            <ListBox Classes="top-tabs"
                     ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     HorizontalAlignment="Stretch">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Header}"
                                   VerticalAlignment="Center"
                                   Margin="7,0"
                                   Padding="3,1" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Content Area -->
        <ContentControl Grid.Row="2"
                        Margin="4,2,4,4"
                        Content="{Binding SelectedTab.Content}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
    </Grid>

</Window>
