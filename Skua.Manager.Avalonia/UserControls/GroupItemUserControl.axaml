<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uc="clr-namespace:Skua.Manager.Avalonia.UserControls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.Manager.Avalonia.UserControls.GroupItemUserControl"
             mc:Ignorable="d"
             d:DesignWidth="700"
             d:DesignHeight="220">
    <Expander Margin="0,0,0,6"
              IsExpanded="{Binding IsExpanded}"
              Background="{DynamicResource SkuaSurfaceAltBrush}"
              BorderBrush="{DynamicResource SkuaBorderBrush}"
              BorderThickness="0,0,0,1">
        <Expander.Header>
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                  ColumnSpacing="4"
                  MinHeight="36">
                <TextBlock Grid.Column="0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Text="{Binding Name}" />

                <Button Grid.Column="1"
                        Margin="4,0"
                        Classes="icon icon-28"
                        Command="{Binding StartCommand}"
                        ToolTip.Tip="Start Group">
                    <materialIcons:MaterialIcon Kind="PlayCircleOutline"
                                                Width="16"
                                                Height="16" />
                </Button>

                <Button Grid.Column="2"
                        Margin="0,0,4,0"
                        Classes="icon icon-28"
                        Command="{Binding StartWithScriptCommand}"
                        ToolTip.Tip="Start Group With Script">
                    <materialIcons:MaterialIcon Kind="ScriptTextPlayOutline"
                                                Width="16"
                                                Height="16" />
                </Button>

                <Button Grid.Column="3"
                        Margin="0,0,4,0"
                        Classes="icon icon-28 icon-muted"
                        Command="{Binding RenameCommand}"
                        ToolTip.Tip="Rename Group">
                    <materialIcons:MaterialIcon Kind="PencilOutline"
                                                Width="16"
                                                Height="16" />
                </Button>

                <Button Grid.Column="4"
                        Classes="icon icon-28 icon-muted"
                        Command="{Binding RemoveCommand}"
                        ToolTip.Tip="Remove Group">
                    <materialIcons:MaterialIcon Kind="DeleteOutline"
                                                Width="16"
                                                Height="16" />
                </Button>
            </Grid>
        </Expander.Header>

        <ItemsControl ItemsSource="{Binding Accounts}"
                      Margin="6,4,6,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <uc:GroupAccountRow Margin="0,0,4,4" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Expander>
</UserControl>
