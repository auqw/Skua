<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <Color x:Key="SkuaAccentColor">#C9479A</Color>
            <Color x:Key="SkuaAccentForegroundColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="SkuaAccentBrush" Color="{StaticResource SkuaAccentColor}" />
            <SolidColorBrush x:Key="SkuaAccentForegroundBrush" Color="{StaticResource SkuaAccentForegroundColor}" />
            <SolidColorBrush x:Key="SkuaAccentHoverBrush" Color="#D460A8" />
            <SolidColorBrush x:Key="SkuaAccentPressedBrush" Color="#A53A7B" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SkuaPageBrush" Color="#EBEDF1" />
                    <SolidColorBrush x:Key="SkuaSurfaceBrush" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="SkuaSurfaceAltBrush" Color="#FCFCFD" />
                    <SolidColorBrush x:Key="SkuaBorderBrush" Color="#A8AEB9" />
                    <SolidColorBrush x:Key="SkuaTextBrush" Color="#22262E" />
                    <SolidColorBrush x:Key="SkuaMutedTextBrush" Color="#5D6471" />
                    <SolidColorBrush x:Key="SkuaSelectionBrush" Color="#66C9479A" />
                    <SolidColorBrush x:Key="SkuaNavChipBrush" Color="#EAEDF2" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SkuaPageBrush" Color="#22252B" />
                    <SolidColorBrush x:Key="SkuaSurfaceBrush" Color="#2B2F36" />
                    <SolidColorBrush x:Key="SkuaSurfaceAltBrush" Color="#333840" />
                    <SolidColorBrush x:Key="SkuaBorderBrush" Color="#6C7481" />
                    <SolidColorBrush x:Key="SkuaTextBrush" Color="#ECEFF4" />
                    <SolidColorBrush x:Key="SkuaMutedTextBrush" Color="#B2B9C6" />
                    <SolidColorBrush x:Key="SkuaSelectionBrush" Color="#66C9479A" />
                    <SolidColorBrush x:Key="SkuaNavChipBrush" Color="#383E48" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource SkuaPageBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.65" />
    </Style>

    <Style Selector="ToggleButton">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ToggleButton:checked">
        <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

</Styles>
