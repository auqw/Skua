<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cp="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
             xmlns:sharedSettings="clr-namespace:Skua.Shared.Avalonia.Controls.Settings"
             x:Class="Skua.Shared.Avalonia.Controls.Theming.AccentEditorPanel"
             x:Name="Root">
  <StackPanel Spacing="8">
    <TextBlock FontWeight="SemiBold" Text="Accent" />

    <Grid ColumnDefinitions="220,1,*">
      <StackPanel Grid.Column="0" Spacing="6">
        <sharedSettings:LabeledToggleRow Label="Dark Mode"
                                         IsChecked="{Binding ThemeService.IsDarkTheme}" />

        <sharedSettings:LabeledToggleRow Label="Color Adjustment"
                                         IsChecked="{Binding ThemeService.IsColorAdjusted}" />

        <Border Margin="0,2,0,2"
                Height="1"
                Background="{Binding SeparatorBrush, ElementName=Root}" />

        <StackPanel IsVisible="{Binding ThemeService.IsColorAdjusted}" Spacing="6">
          <TextBlock FontWeight="SemiBold" Text="Advanced Color Adjustment" />
          <TextBlock Margin="0,2,0,0" Text="Desired Contrast Ratio" />

          <sharedSettings:SliderValueRow Minimum="1"
                                         Maximum="21"
                                         TickFrequency="0.1"
                                         IsSnapToTickEnabled="True"
                                         Value="{Binding ThemeService.DesiredContrastRatio}" />

          <TextBlock Margin="0,2,0,0" Text="Contrast" />
          <ComboBox ItemsSource="{Binding ThemeService.ContrastValues}"
                    SelectedItem="{Binding ThemeService.ContrastValue}" />
        </StackPanel>
      </StackPanel>

      <Border Grid.Column="1"
              Margin="8,0"
              Width="1"
              Background="{Binding SeparatorBrush, ElementName=Root}" />

      <Grid Grid.Column="2" Margin="10,0,0,0" RowDefinitions="Auto,*">
        <TextBlock Text="Custom Picker" />
        <cp:ColorView x:Name="AccentColorView"
                      Grid.Row="1"
                      Color="{Binding ThemeService.SelectedColor, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      MinHeight="340"
                      Height="380"
                      IsAccentColorsVisible="True"
                      IsAlphaVisible="True"
                      IsColorPaletteVisible="True"
                      IsColorComponentsVisible="True"
                      IsComponentSliderVisible="True"
                      IsComponentTextInputVisible="True"
                      IsColorModelVisible="True"
                      IsColorSpectrumVisible="True"
                      IsColorSpectrumSliderVisible="True"
                      IsHexInputVisible="True" />
      </Grid>
    </Grid>
  </StackPanel>
</UserControl>
