<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.Shared.Avalonia.Controls.Settings.OptionSectionControl"
             x:Name="Root">
  <Border BorderBrush="{DynamicResource SkuaBorderBrush}"
          BorderThickness="1"
          CornerRadius="4"
          Padding="6">
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding Title, ElementName=Root}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,2" />
      <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="0,0,0,1" Padding="6">
              <StackPanel Spacing="3">
                <CheckBox Content="{Binding Content}"
                          IsChecked="{Binding Value, Mode=TwoWay}"
                          Command="{Binding Command}"
                          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
                <TextBlock Text="{Binding Description}"
                           FontSize="11"
                           Foreground="{DynamicResource SkuaMutedTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
