<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Scheme Target mapping:
        Primary -> SkuaAccentColor / SkuaAccentBrush
        Text on Primary -> SkuaAccentForegroundColor / SkuaAccentForegroundBrush
        These are updated at runtime by ThemeResourceApplicator via theme editor selections. -->
    
    <Color x:Key="SkuaAccentColor">#FF607D8B</Color>
    <Color x:Key="SkuaAccentForegroundColor">#FF000000</Color>
    <SolidColorBrush x:Key="SkuaAccentBrush" Color="{StaticResource SkuaAccentColor}" />
    <SolidColorBrush x:Key="SkuaAccentForegroundBrush" Color="{StaticResource SkuaAccentForegroundColor}" />
    <SolidColorBrush x:Key="SkuaAccentHoverBrush" Color="#FF78909C" />
    <SolidColorBrush x:Key="SkuaAccentPressedBrush" Color="#FF546E7A" />
    <SolidColorBrush x:Key="SkuaDangerHoverBrush" Color="#CCB93A32" />
    <SolidColorBrush x:Key="SkuaDangerForegroundBrush" Color="#FFFFFFFF" />

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SkuaPageBrush" Color="#FFFAFAFA" />
            <SolidColorBrush x:Key="SkuaSurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SkuaSurfaceAltBrush" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="SkuaBorderBrush" Color="#FFE0E0E0" />
            <SolidColorBrush x:Key="SkuaNavHoverBrush" Color="#FFECEFF1" />
            <SolidColorBrush x:Key="SkuaTextBrush" Color="#FF212121" />
            <SolidColorBrush x:Key="SkuaMutedTextBrush" Color="#FF616161" />
            <SolidColorBrush x:Key="SkuaSelectionBrush" Color="#33607D8B" />
            <SolidColorBrush x:Key="SkuaHoverBrush" Color="#14000000" />
            <SolidColorBrush x:Key="SkuaHoverPressedBrush" Color="#22000000" />
            <SolidColorBrush x:Key="SkuaNavChipBrush" Color="#FFF1F3F4" />
        </ResourceDictionary>
      
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SkuaPageBrush" Color="#424242" />
            <SolidColorBrush x:Key="SkuaSurfaceBrush" Color="#4E4E4E" />
            <SolidColorBrush x:Key="SkuaSurfaceAltBrush" Color="#303030" />
            <SolidColorBrush x:Key="SkuaBorderBrush" Color="#303030" />
            <SolidColorBrush x:Key="SkuaNavHoverBrush" Color="#303030" />
            <SolidColorBrush x:Key="SkuaTextBrush" Color="#ECEFF4" />
            <SolidColorBrush x:Key="SkuaMutedTextBrush" Color="#C3CAD0" />
            <SolidColorBrush x:Key="SkuaSelectionBrush" Color="#66607D8B" />
            <SolidColorBrush x:Key="SkuaHoverBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="SkuaHoverPressedBrush" Color="#2AFFFFFF" />
            <SolidColorBrush x:Key="SkuaNavChipBrush" Color="#303030" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
