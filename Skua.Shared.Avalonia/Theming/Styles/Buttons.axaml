<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:buttons="clr-namespace:Skua.Shared.Avalonia.Controls.Buttons"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:shell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell">
    
    <!-- Keep button template behavior centralized so skua-button/topbar/titlebar variants
         share one base and respond consistently when accent resources change at runtime. -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        
        <Style Selector="^.skua-button">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        
        <Style Selector="^.skua-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SkuaAccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaAccentForegroundBrush}" />
        </Style>

        <Style Selector="^.skua-button:pressed">
            <Setter Property="Background" Value="{DynamicResource SkuaAccentPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaAccentForegroundBrush}" />
        </Style>

        <Style Selector="^.skua-button:disabled">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        
        <Style Selector="^.topbar-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MaxHeight" Value="25" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style Selector="^.topbar-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
        </Style>
        
        <Style Selector="^.titlebar">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
        </Style>

        <Style Selector="^.titlebar:pointerover">
            <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        </Style>

        <Style Selector="^.titlebar:pressed">
            <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
        </Style>

        <Style Selector="^.titlebar-close:pointerover">
            <Setter Property="Background" Value="#CCB93A32" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
    </ControlTheme>
    
    
    
    <ControlTheme x:Key="{x:Type buttons:IconTextButton}" TargetType="buttons:IconTextButton">
        
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="7,2" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Button Command="{TemplateBinding Command}"
                        CommandParameter="{TemplateBinding CommandParameter}"
                        Padding="{TemplateBinding ButtonPadding}"
                        HorizontalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="{TemplateBinding Spacing}">
                        <materialIcons:MaterialIcon Kind="{TemplateBinding IconKind}"
                                                    Width="{TemplateBinding IconSize}"
                                                    Height="{TemplateBinding IconSize}"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="{TemplateBinding Text}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    
