<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialControls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles">
    <Styles.Resources>
    </Styles.Resources>
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>
    
    <Style Selector="TextBox.gap-left-8, NumericUpDown.gap-left-8">
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style Selector="TextBox.gap-right-8, NumericUpDown.gap-right-8">
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style Selector="Window.skua TextBox">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="Window.skua TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>

    <!-- Some theme templates keep text flush even when TextBox.Padding is set.
         Force an inner inset on the text presenter to keep content off the left edge. -->
    <Style Selector="Window.skua TextBox /template/ ScrollViewer#PART_TextPresenter">
        <Setter Property="Padding" Value="6,0" />
    </Style>

    <!-- Apply inner text inset consistently across all text boxes in Skua. -->
    <Style Selector="Window.skua TextBox /template/ TextPresenter#PART_TextPresenter">
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <!-- In empty state, nudge watermark text to align with inset content. -->
    <Style Selector="Window.skua TextBox:empty /template/ TextBlock">
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    
    <Style Selector="Window.skua TextBox.option-pill-input">
        <Setter Property="Width" Value="160" />
        <Setter Property="MinWidth" Value="70" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SkuaSelectionBrush}" />
    </Style>

    <Style Selector="Window.skua TextBox.option-pill-input:focus">
        <Setter Property="Background" Value="{DynamicResource SkuaHoverBrush}" />
    </Style>

    <Style Selector="Window.skua TextBox.option-pill-input /template/ ScrollViewer#PART_TextPresenter">
        <Setter Property="Padding" Value="10,0,0,0" />
    </Style>

    <Style Selector="Window.skua TextBox.option-pill-input /template/ TextPresenter#PART_TextPresenter">
        <Setter Property="Margin" Value="10,0,0,0" />
    </Style>

    <Style Selector="Window.skua TextBox.option-pill-input /template/ Border#PART_RootBorder">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16,0,0,16" />
    </Style>

    <Style Selector="Window.skua TextBox.option-pill-input /template/ Border#borderElement">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16,0,0,16" />
    </Style>

    <Style Selector="Window.skua TextBox.option-pill-input:empty /template/ TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        <Setter Property="Margin" Value="10,0,0,0" />
    </Style>

    <!-- Material template underline opt-out for pill inputs. -->
    <Style Selector="Window.skua TextBox.option-pill-input /template/ materialControls|MaterialUnderline">
        <Setter Property="IsVisible" Value="False" />
    </Style>

</Styles>
