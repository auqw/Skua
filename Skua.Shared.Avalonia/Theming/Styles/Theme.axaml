<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialControls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Skua.Shared.Avalonia/Theming/Colors.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- This is the shared theme root. Token resources live above, and focused control
       rules are split into includes below so style behavior is easier to audit by file. -->
  <StyleInclude Source="avares://Skua.Shared.Avalonia/Theming/Styles/TextBlocks.axaml" />
  <StyleInclude Source="avares://Skua.Shared.Avalonia/Theming/Styles/TextBoxes.axaml" />
  <StyleInclude Source="avares://Skua.Shared.Avalonia/Theming/Styles/ComboBoxes.axaml" />
  <StyleInclude Source="avares://Skua.Shared.Avalonia/Theming/Styles/ScrollViewers.axaml" />

  <!-- Root shell scope. Windows opt into shared theming with Classes="skua", then
       descendants inherit these defaults and scoped control rules. -->
  <Style Selector="Window.skua">
    <Setter Property="Background" Value="{DynamicResource SkuaPageBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Button.skua-button">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <!-- Use "Text on Primary" from Scheme Target -->
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentForegroundBrush}" />
  </Style>

  <Style Selector="Button.skua-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentForegroundBrush}" />
  </Style>

  <Style Selector="Button.skua-button:pressed">
    <Setter Property="Background" Value="{DynamicResource SkuaAccentPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentForegroundBrush}" />
  </Style>

  <Style Selector="Button.skua-button:disabled">
    <Setter Property="Opacity" Value="0.65" />
  </Style>

  <Style Selector="ToggleButton.app-toggle">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
  </Style>

  <Style Selector="ToggleButton.app-toggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaHoverBrush}" />
  </Style>

  <Style Selector="ToggleButton.app-toggle:pressed">
    <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.app-toggle:checked">
    <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.app-toggle:checked:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.app-toggle:checked:pressed">
    <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Window.skua ListBox">
    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Window.skua ListBoxItem">
    <Setter Property="Padding" Value="4,3" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="Window.skua ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
  </Style>

  <Style Selector="Window.skua CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
  </Style>

  <Style Selector="Window.skua Border.option-pill-container">
    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="MaxHeight" Value="22" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Window.skua TextBox.option-pill-input">
    <Setter Property="Width" Value="160" />
    <Setter Property="MinWidth" Value="70" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource SkuaSelectionBrush}" />
  </Style>

  <Style Selector="Window.skua TextBox.option-pill-input:focus">
    <Setter Property="Background" Value="{DynamicResource SkuaHoverBrush}" />
  </Style>

  <Style Selector="Window.skua TextBox.option-pill-input /template/ ScrollViewer#PART_TextPresenter">
    <Setter Property="Padding" Value="10,0,0,0" />
  </Style>

  <Style Selector="Window.skua TextBox.option-pill-input /template/ TextPresenter#PART_TextPresenter">
    <Setter Property="Margin" Value="10,0,0,0" />
  </Style>

  <Style Selector="Window.skua TextBox.option-pill-input /template/ Border#PART_RootBorder">
    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="16,0,0,16" />
  </Style>

  <Style Selector="Window.skua TextBox.option-pill-input /template/ Border#borderElement">
    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="16,0,0,16" />
  </Style>

  <Style Selector="Window.skua TextBox.option-pill-input:empty /template/ TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
    <Setter Property="Margin" Value="10,0,0,0" />
  </Style>

  <!-- Material template underline opt-out for pill inputs. -->
  <Style Selector="Window.skua TextBox.option-pill-input /template/ materialControls|MaterialUnderline">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="Window.skua Button.option-pill-action">
    <Setter Property="Theme" Value="{x:Null}" />
    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0,16,16,0" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Window.skua Button.option-pill-action /template/ Border#PART_RootBorder">
    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0,16,16,0" />
  </Style>

  <Style Selector="Window.skua Button.option-pill-action /template/ ContentPresenter">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaTextBrush}" />
    <Setter Property="TextElement.FontWeight" Value="Normal" />
  </Style>

  <Style Selector="Window.skua Button.option-pill-action-auto">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="MinWidth" Value="64" />
  </Style>

  <Style Selector="Window.skua Button.option-pill-action:pointerover /template/ Border#PART_RootBorder">
    <Setter Property="Background" Value="{DynamicResource SkuaHoverBrush}" />
  </Style>

  <Style Selector="Window.skua Button.option-pill-action:pressed /template/ Border#PART_RootBorder">
    <Setter Property="Background" Value="{DynamicResource SkuaHoverPressedBrush}" />
  </Style>

  <Style Selector="Window.skua TextBlock.option-pill-suffix">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,0,2,0" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="Window.skua Button.option-action-button">
    <Setter Property="Theme" Value="{x:Null}" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="MaxHeight" Value="22" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Window.skua Button.option-action-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaHoverBrush}" />
  </Style>

  <Style Selector="Window.skua Button.option-action-button:pressed">
    <Setter Property="Background" Value="{DynamicResource SkuaHoverPressedBrush}" />
  </Style>

  <!-- Option booleans use a filter-chip look (WPF parity): button-like unchecked/checked states. -->
  <Style Selector="Window.skua ToggleButton.option-chip">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Window.skua ToggleButton.option-chip /template/ Border#PART_RootBorder">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="Window.skua ToggleButton.option-chip /template/ ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Window.skua ToggleButton.option-chip /template/ Border#PART_HoverEffect">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="Window.skua ToggleButton.option-chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Window.skua ToggleButton.option-chip:pressed">
    <Setter Property="Background" Value="{DynamicResource SkuaHoverPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Window.skua ToggleButton.option-chip:checked">
    <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Window.skua ToggleButton.option-chip:pointerover /template/ Border#PART_RootBorder">
    <Setter Property="Background" Value="{DynamicResource SkuaHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Window.skua ToggleButton.option-chip:pressed /template/ Border#PART_RootBorder">
    <Setter Property="Background" Value="{DynamicResource SkuaHoverPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentPressedBrush}" />
  </Style>

  <Style Selector="Window.skua ToggleButton.option-chip:checked /template/ Border#PART_RootBorder">
    <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Window.skua ToggleButton.option-chip:checked /template/ ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Window.skua ToggleButton.option-chip:checked:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaHoverPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Window.skua ToggleButton.option-chip:checked:pressed">
    <Setter Property="Background" Value="{DynamicResource SkuaHoverPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Window.skua ToggleButton.option-chip:disabled">
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="Menu.top-toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Topbar dropdown items (Options/Helpers/etc submenu entries) -->
  <Style Selector="Menu.top-toolbar MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Menu.top-toolbar MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Menu.top-toolbar MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Menu.top-toolbar MenuItem:selected, Menu.top-toolbar MenuItem:submenuopen">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <!-- Popup/opened menus (submenu + context menus) -->
  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="MenuFlyoutPresenter MenuItem, ContextMenu MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="MenuFlyoutPresenter MenuItem:pointerover, ContextMenu MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuFlyoutPresenter MenuItem:selected, ContextMenu MenuItem:selected">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item">
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MaxHeight" Value="25" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style Selector="Button.top-nav-item">
    <Setter Property="Theme" Value="{StaticResource MaterialFlatButton}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="25" />
    <Setter Property="Height" Value="25" />
    <Setter Property="MaxHeight" Value="25" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style Selector="ToggleButton.top-nav-item">
    <Setter Property="Theme" Value="{StaticResource MaterialFlatToggleButton}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="25" />
    <Setter Property="Height" Value="25" />
    <Setter Property="MaxHeight" Value="25" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style Selector="MenuItem.top-nav-item /template/ Border#PART_Presenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Button.top-nav-item:pointerover, ToggleButton.top-nav-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Button.top-nav-item /template/ ContentPresenter, ToggleButton.top-nav-item /template/ ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Button.top-nav-item /template/ Border#PART_RootBorder, ToggleButton.top-nav-item /template/ Border#PART_RootBorder">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.top-nav-item:pointerover /template/ Border#PART_RootBorder, ToggleButton.top-nav-item:pointerover /template/ Border#PART_RootBorder">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
  </Style>

  <Style Selector="Button.top-nav-item /template/ Border#PART_HoverEffect">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="Button.top-nav-item:pointerover /template/ Border#PART_HoverEffect">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="Button.top-nav-item:focus-visible /template/ Border#PART_HoverEffect">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="ToggleButton.top-nav-item:checked /template/ Border#PART_RootBorder">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:pointerover /template/ Border#PART_Presenter">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:selected">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.top-nav-item:checked">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:selected /template/ Border#PART_Presenter">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:submenuopen">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:submenuopen /template/ Border#PART_Presenter">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:submenuopen /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Border.titlebar-app-badge">
    <Setter Property="Background" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="TextBlock.titlebar-title">
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Button.titlebar">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Button.titlebar:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
  </Style>

  <Style Selector="Button.titlebar:pressed">
    <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
  </Style>

  <Style Selector="Button.titlebar-close:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaDangerHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaDangerForegroundBrush}" />
  </Style>
</Styles>
