<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <Color x:Key="SkuaAccentColor">#7D9AA9</Color>
      <Color x:Key="SkuaAccentForegroundColor">#FFFFFFFF</Color>
      <SolidColorBrush x:Key="SkuaAccentBrush" Color="{StaticResource SkuaAccentColor}" />
      <SolidColorBrush x:Key="SkuaAccentForegroundBrush" Color="{StaticResource SkuaAccentForegroundColor}" />
      <SolidColorBrush x:Key="SkuaAccentHoverBrush" Color="#8BAAB8" />
      <SolidColorBrush x:Key="SkuaAccentPressedBrush" Color="#6C8794" />

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SkuaPageBrush" Color="#FFFAFAFA" />
          <SolidColorBrush x:Key="SkuaSurfaceBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="SkuaSurfaceAltBrush" Color="#FFF5F5F5" />
          <SolidColorBrush x:Key="SkuaBorderBrush" Color="#FFE0E0E0" />
          <SolidColorBrush x:Key="SkuaNavHoverBrush" Color="#FFECEFF1" />
          <SolidColorBrush x:Key="SkuaTextBrush" Color="#FF212121" />
          <SolidColorBrush x:Key="SkuaMutedTextBrush" Color="#FF616161" />
          <SolidColorBrush x:Key="SkuaSelectionBrush" Color="#337D9AA9" />
          <SolidColorBrush x:Key="SkuaNavChipBrush" Color="#FFF1F3F4" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SkuaPageBrush" Color="#424242" />
          <SolidColorBrush x:Key="SkuaSurfaceBrush" Color="#424242" />
          <SolidColorBrush x:Key="SkuaSurfaceAltBrush" Color="#303030" />
          <SolidColorBrush x:Key="SkuaBorderBrush" Color="#303030" />
          <SolidColorBrush x:Key="SkuaNavHoverBrush" Color="#303030" />
          <SolidColorBrush x:Key="SkuaTextBrush" Color="#ECEFF4" />
          <SolidColorBrush x:Key="SkuaMutedTextBrush" Color="#C3CAD0" />
          <SolidColorBrush x:Key="SkuaSelectionBrush" Color="#667D9AA9" />
          <SolidColorBrush x:Key="SkuaNavChipBrush" Color="#303030" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource SkuaPageBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentForegroundBrush}" />
  </Style>

  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentForegroundBrush}" />
  </Style>

  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{DynamicResource SkuaAccentPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentForegroundBrush}" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.65" />
  </Style>

  <Style Selector="ToggleButton">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
  </Style>

  <Style Selector="ToggleButton:checked">
    <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="4,3" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Menu.top-toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="MenuItem.top-nav-item">
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MaxHeight" Value="25" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style Selector="MenuItem.top-nav-item /template/ Border#PART_Presenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:pointerover /template/ Border#PART_Presenter">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:selected">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:selected /template/ Border#PART_Presenter">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:submenuopen">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:submenuopen /template/ Border#PART_Presenter">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:submenuopen /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Border.topbar-popup">
    <Setter Property="MinWidth" Value="280" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Background" Value="{DynamicResource SkuaPageBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Border.titlebar-app-badge">
    <Setter Property="Background" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="TextBlock.titlebar-title">
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Button.titlebar">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Button.titlebar:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
  </Style>

  <Style Selector="Button.titlebar:pressed">
    <Setter Property="Background" Value="{DynamicResource SkuaSelectionBrush}" />
  </Style>

  <Style Selector="Button.titlebar-close:pointerover">
    <Setter Property="Background" Value="#CCB93A32" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
  </Style>
</Styles>
