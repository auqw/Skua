<UserControl
    x:Class="Skua.WPF.Views.ScriptRepoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:Skua.Core.ViewModels;assembly=Skua.Core"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vms:ScriptRepoViewModel}">

    <Grid Margin="8">

        <!-- ================= MAIN LAYOUT ================= -->
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= TOP BAR ================= -->
            <Border Grid.Row="0"
                    Margin="0,0,0,8"
                    Padding="10"
                    Background="#1E1E1E"
                    CornerRadius="6">

                <DockPanel LastChildFill="True">
                    <DockPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                            <Setter Property="Margin" Value="0,0,6,0" />
                        </Style>
                    </DockPanel.Resources>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="Update All"
                                Margin="0,0,6,0"
                                Command="{Binding UpdateAllCommand}" />

                        <Button Content="Download All"
                                Margin="0,0,6,0"
                                Command="{Binding DownloadAllCommand}" />
                    </StackPanel>

                    <Button Content="Refresh"
                            DockPanel.Dock="Right"
                            Command="{Binding RefreshScriptsCommand}" />

                    <ComboBox x:Name="SearchScopeCombo"
                              Width="56"
                              Margin="10,0,6,0"
                              SelectedIndex="0"
                              SelectionChanged="SearchScopeCombo_SelectionChanged">
                        <ComboBoxItem Content="All" />
                        <ComboBoxItem Content="Name" />
                        <ComboBoxItem Content="Tag" />
                        <ComboBoxItem Content="Desc" />
                    </ComboBox>

                    <TextBox x:Name="SearchBox"
                             Margin="0,0,0,0"
                             Padding="6"
                             materialDesign:HintAssist.Hint="Search scripts..."
                             MaxLines="1"
                             UseLayoutRounding="True"
                             TextChanged="TextBox_TextChanged" />
                </DockPanel>
            </Border>
            <!-- ================= SCRIPT LIST CONTAINER ================= -->
            <Border Grid.Row="1"
                    Background="#303030"
                    CornerRadius="6"
                    Padding="4">

                    <ListBox x:Name="ScriptsList"
                             BorderThickness="0"
                             Background="Transparent"

                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                             SelectedItem="{Binding SelectedItem}"
                             SelectionMode="Single"
                             PreviewMouseRightButtonDown="ScriptsList_PreviewMouseRightButtonDown">

                    <!-- CONTEXT MENU -->
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem
                                Command="{Binding PlacementTarget.DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="Download"
                                IsEnabled="{Binding PlacementTarget.DataContext.SelectedItem.Downloaded, Converter={StaticResource InvertBooleanConverter}, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue=False}" />

                            <MenuItem
                                Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="Delete"
                                IsEnabled="{Binding PlacementTarget.DataContext.SelectedItem.Downloaded, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue=False}" />

                            <MenuItem
                                Command="{Binding PlacementTarget.DataContext.OpenScriptCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="Open in VSCode"
                                IsEnabled="{Binding PlacementTarget.DataContext.SelectedItem.Downloaded, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue=False}" />

                            <MenuItem
                                Command="{Binding PlacementTarget.DataContext.SelectedItem.LoadScriptCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                CommandParameter="{Binding PlacementTarget.DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="Load"
                                IsEnabled="{Binding PlacementTarget.DataContext.SelectedItem.Downloaded, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue=False}" />

                            <MenuItem
                                Command="{Binding PlacementTarget.DataContext.SelectedItem.StartScriptCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                CommandParameter="{Binding PlacementTarget.DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="Start"
                                IsEnabled="{Binding PlacementTarget.DataContext.SelectedItem.Downloaded, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue=False}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <!-- VIRTUALIZED ITEM PANEL -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <!-- ITEM CONTAINER -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!-- SCRIPT CARD -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Margin="4"
                                    Padding="10"
                                    Background="#1E1E1E"
                                    CornerRadius="6"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    ToolTip="{Binding Info.Description}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT -->
                                    <StackPanel>

                                        <TextBlock Text="{Binding Info.Name}"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />

                                        <TextBlock Text="{Binding Info.Description}"
                                                   Foreground="#AAA"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />

                                        <TextBlock Text="{Binding ScriptPathFromScriptsDir}"
                                                   Foreground="#666"
                                                   FontSize="10"
                                                   Margin="0,2,0,0" />

                                        <ItemsControl ItemsSource="{Binding InfoTags}"
                                                      Margin="0,6,0,0">

                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#2A2A2A"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="0,0,6,4">

                                                        <TextBlock Text="{Binding}"
                                                                   Foreground="#97d2de"
                                                                   FontSize="11" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- RIGHT ACTIONS -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">

                                        <Button Content="Start"
                                                Width="70"
                                                Margin="0,0,6,0"
                                                Command="{Binding StartScriptCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding Downloaded}" />

                                        <Button Content="Load"
                                                Width="70"
                                                Command="{Binding LoadScriptCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding Downloaded}" />

                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- ================= STATUS BAR ================= -->
            <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="10"
                    Background="#1E1E1E"
                    CornerRadius="6">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Scripts:" Foreground="#888" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding BotScriptQuantity}" Foreground="White" Margin="0,0,18,0" />

                    <TextBlock Text="Downloaded:" Foreground="#888" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding DownloadedQuantity}" Foreground="White" Margin="0,0,4,0" />
                    <TextBlock Text="/" Foreground="#888" />
                    <TextBlock Text="{Binding ScriptQuantity}" Foreground="White" Margin="0,0,18,0" />

                    <TextBlock Text="Outdated:" Foreground="#888" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding OutdatedQuantity}" Foreground="#FFD166" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= FLOATING SNACKBAR (FIXED) ================= -->
        <materialDesign:Snackbar
            Panel.ZIndex="999"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="12"
            IsActive="{Binding ProgressReportMessage, Converter={StaticResource StringToBoolConverter}}">

            <materialDesign:SnackbarMessage
                ActionCommand="{Binding CancelTaskCommand}"
                ActionContent="{materialDesign:PackIcon Kind=Cancel}"
                Content="{Binding ProgressReportMessage}" />
        </materialDesign:Snackbar>
    </Grid>
</UserControl>
