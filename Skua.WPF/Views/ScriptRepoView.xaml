<UserControl
    x:Class="Skua.WPF.Views.ScriptRepoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:Skua.Core.ViewModels;assembly=Skua.Core"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vms:ScriptRepoViewModel}">

    <Grid Margin="8">

        <!-- ================= MAIN LAYOUT ================= -->
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= TOP BAR ================= -->
            <Border Grid.Row="0"
                    Margin="0,0,0,8"
                    Padding="10"
                    Background="#1E1E1E"
                    CornerRadius="6">

                <DockPanel LastChildFill="True">

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="Update All"
                                Margin="0,0,6,0"
                                Command="{Binding UpdateAllCommand}" />

                        <Button Content="Download All"
                                Margin="0,0,6,0"
                                Command="{Binding DownloadAllCommand}" />
                    </StackPanel>

                    <Button Content="Refresh"
                            DockPanel.Dock="Right"
                            Command="{Binding RefreshScriptsCommand}" />

                    <TextBox x:Name="SearchBox"
                             Margin="10,0"
                             Padding="6"
                             materialDesign:HintAssist.Hint="Search scripts..."
                             TextChanged="TextBox_TextChanged" />
                </DockPanel>
            </Border>

            <!-- ================= DATA GRID ================= -->
            <DataGrid Grid.Row="1"
                      x:Name="ScriptsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="None"
                      GridLinesVisibility="None"

                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"

                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                      SelectedItem="{Binding SelectedItem}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      PreviewMouseRightButtonDown="ScriptsDataGrid_PreviewMouseRightButtonDown">

                <!-- ROW STYLE -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow"
                           BasedOn="{StaticResource MaterialDesignDataGridRow}">

                        <Setter Property="Background" Value="Transparent" />

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.97" />
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2D2D2D" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <!-- COLUMN -->
                <DataGrid.Columns>

                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Margin="4"
                                        Padding="10"
                                        Background="#1E1E1E"
                                        CornerRadius="6"
                                        BorderBrush="#2A2A2A"
                                        BorderThickness="1">

                                    <!-- TOOLTIP -->
                                    <Border.ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Info.Name}"
                                                       FontWeight="Bold"
                                                       Foreground="White" />

                                            <TextBlock Text="{Binding Info.Description}"
                                                       TextWrapping="Wrap"
                                                       Width="260"
                                                       Foreground="#AAA" />
                                        </StackPanel>
                                    </Border.ToolTip>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- LEFT -->
                                        <StackPanel>

                                            <TextBlock Text="{Binding Info.Name}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Text="{Binding Info.Description}"
                                                       Foreground="#AAA"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="32"
                                                       Margin="0,4,0,0" />

                                            <ItemsControl ItemsSource="{Binding InfoTags}"
                                                          Margin="0,6,0,0">

                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#2A2A2A"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding}"
                                                                       Foreground="#97d2de"
                                                                       FontSize="11" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- RIGHT ACTIONS -->
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                                     Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Button Content="Start"
                                                    Width="70"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding StartScriptCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding Downloaded}" />

                                            <Button Content="Load"
                                                    Width="70"
                                                    Command="{Binding LoadScriptCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding Downloaded}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ================= STATUS BAR ================= -->
            <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="10"
                    Background="#1E1E1E"
                    CornerRadius="6">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Scripts:" Foreground="#888" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding BotScriptQuantity}" Foreground="White" Margin="0,0,18,0" />

                    <TextBlock Text="Downloaded:" Foreground="#888" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding DownloadedQuantity}" Foreground="White" Margin="0,0,4,0" />
                    <TextBlock Text="/" Foreground="#888" />
                    <TextBlock Text="{Binding ScriptQuantity}" Foreground="White" Margin="0,0,18,0" />

                    <TextBlock Text="Outdated:" Foreground="#888" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding OutdatedQuantity}" Foreground="#FFD166" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= FLOATING SNACKBAR (FIXED) ================= -->
        <materialDesign:Snackbar
            Panel.ZIndex="999"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="12"
            IsActive="{Binding ProgressReportMessage, Converter={StaticResource StringToBoolConverter}}">

            <materialDesign:SnackbarMessage
                ActionCommand="{Binding CancelTaskCommand}"
                ActionContent="{materialDesign:PackIcon Kind=Cancel}"
                Content="{Binding ProgressReportMessage}" />
        </materialDesign:Snackbar>
    </Grid>
</UserControl>