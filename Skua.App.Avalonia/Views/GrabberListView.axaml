<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.App.Avalonia.Views.GrabberListView">
  <Grid RowDefinitions="Auto,Auto,*,Auto"
        Margin="8">
    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,*">
      <Button Grid.Column="0"
              Classes="skua-button"
              Content="Grab"
              Command="{Binding GrabCommand}" />
      <TextBlock Grid.Column="1"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 Text="{Binding ProgressReportMessage}" />
    </Grid>

    <TextBox Grid.Row="1"
             Margin="0,8,0,0"
             Watermark="Filter"
             Text="{Binding SearchText}" />

    <Border Grid.Row="2"
            Margin="0,8,0,0"
            BorderThickness="1"
            BorderBrush="{DynamicResource SkuaNavHoverBrush}">
      <ListBox x:Name="GrabbedItemsList"
               ItemsSource="{Binding GrabbedItems}"
               SelectionMode="Multiple"
               BorderThickness="0"
               Background="Transparent" />
    </Border>

    <ItemsControl Grid.Row="3"
                  Margin="0,8,0,0"
                  ItemsSource="{Binding GrabberCommands}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Classes="skua-button"
                  Margin="0,0,0,6"
                  Content="{Binding Content}"
                  Click="GrabberTaskButton_Click" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
