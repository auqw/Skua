<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Skua.App.Avalonia.Views.MainWindow"
        Width="1280"
        Height="780"
        MinWidth="1024"
        MinHeight="640"
        Title="{Binding Title}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/SkuaIcon.ico">
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Height="25">
      <Menu x:Name="MainMenuControl" Classes="top-toolbar" Margin="8,0,0,0" />

      <StackPanel x:Name="TopActionsPanel"
                  Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="0"
                  Margin="0,0,6,0"
                  PointerEntered="NonMenuArea_PointerEntered">
        <ToggleButton x:Name="AutoToggle" Classes="topbar-action" Content="Auto" />
        <Popup x:Name="AutoPopup"
               IsOpen="{Binding IsChecked, ElementName=AutoToggle}"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=AutoToggle}"
               HorizontalOffset="-220"
               IsLightDismissEnabled="True">
          <Border x:Name="AutoPanel" Classes="topbar-popup">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AutoAttackButton" Content="Attack" />
                <Button x:Name="AutoHuntButton" Content="Hunt" />
                <Button x:Name="AutoStopButton" Content="Stop" />
              </StackPanel>
              <TextBlock x:Name="AutoClassText" />
            </StackPanel>
          </Border>
        </Popup>

        <ToggleButton x:Name="JumpToggle" Classes="topbar-action" Content="Jump" />
        <Popup x:Name="JumpPopup"
               IsOpen="{Binding IsChecked, ElementName=JumpToggle}"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=JumpToggle}"
               HorizontalOffset="-185"
               IsLightDismissEnabled="True">
          <Border x:Name="JumpPanel" Classes="topbar-popup">
            <StackPanel Spacing="8">
              <TextBox x:Name="JumpCellTextBox" Watermark="Cell" />
              <TextBox x:Name="JumpPadTextBox" Watermark="Pad" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="JumpCurrentButton" Content="Current" />
                <Button x:Name="JumpRefreshButton" Content="Refresh" />
                <Button x:Name="JumpGoButton" Content="Jump" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Popup>

        <Button x:Name="BotWindowButton" Classes="topbar-action" Content="+" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Background="#000000" PointerEntered="NonMenuArea_PointerEntered">
      <!--<controls:WinFormsFlashHost x:Name="FlashHost" IsVisible="False" />-->
      <ProgressBar x:Name="LoadingBar"
                   Width="150"
                   Height="8"
                   IsIndeterminate="True"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource SkuaPageBrush}"
            BorderBrush="{DynamicResource SkuaNavHoverBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,4">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock x:Name="FpsMetricText" Text="FPS: --" />
        <TextBlock x:Name="WorkingSetMetricText" Text="RAM: --" />
        <TextBlock x:Name="PrivateMetricText" Text="Private: --" />
        <TextBlock x:Name="ManagedMetricText" Text="Managed: --" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
