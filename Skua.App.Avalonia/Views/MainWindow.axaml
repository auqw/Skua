<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="Skua.App.Avalonia.Views.MainWindow"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        
        mc:Ignorable="d" d:DesignWidth="948" d:DesignHeight="600"
        Width="948" Height="600"
        MinWidth="948" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        
        Title="{Binding Title}"
        Icon="avares://Skua.Shared.Avalonia/Assets/SkuaIcon.ico"
        
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        >
  
  <Grid RowDefinitions="Auto,*">
    
    <!-- Custom Titlebar -->
    <Grid Row="0"
          Name="TitleBar"
          Height="32"
          Background="{DynamicResource SkuaPageBrush}"
          >
          
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
          
      <!--  Icon  -->
      <Grid Column="0"
            Width="30"
            Height="30"
            Margin="6,0"
            HorizontalAlignment="Center">
              
        <Border
          Width="30"
          Height="30"
          Background="{DynamicResource PrimaryHueMidBrush}"
          CornerRadius="15"/>
              
        <Image Source="avares://Skua.Shared.Avalonia/Assets/SkuaImage.png" 
               Width="32" Height="32"
               VerticalAlignment="Center"/>
      </Grid>
          
      <!--  Title  -->
      <Viewbox Grid.Column="1"
               Margin="6,0,0,0"
               HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" 
                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
      </Viewbox>
          
      <!--  System Buttons  -->
      <StackPanel Grid.Column="2" 
                  Orientation="Horizontal">
        <Button Name="MinimizeButton" 
                Classes="titlebar flat"
                Foreground="{DynamicResource PrimaryHueMidBrush}"
                Content="{materialIcons:MaterialIconExt Kind=WindowMinimize, IconSize=12}"/>
        <Button Name="MaximizeButton" 
                Classes="titlebar flat"
                Foreground="{DynamicResource PrimaryHueMidBrush}"
                Content="{materialIcons:MaterialIconExt Kind=WindowMaximize, IconSize=12}"/>
        <Button Name="CloseButton" 
                Classes="titlebar flat"
                Foreground="{DynamicResource PrimaryHueMidBrush}"
                Content="{materialIcons:MaterialIconExt Kind=WindowClose, IconSize=12}"/>
      </StackPanel>
    </Grid>
      
    <Grid Row="1"
      RowDefinitions="Auto,*,Auto">
      
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
            Height="25"
            >
        
        <Menu
          x:Name="MainMenuControl"
          Classes="top-toolbar"
          />

        <StackPanel x:Name="TopActionsPanel"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    
                    PointerEntered="NonMenuArea_PointerEntered">
          
          <ToggleButton x:Name="AutoToggle" Classes="topbar-action flat" Content="Auto" />
          <Popup x:Name="AutoPopup"
                 IsOpen="{Binding IsChecked, ElementName=AutoToggle}"
                 Placement="Bottom"
                 PlacementTarget="{Binding ElementName=AutoToggle}"
                 HorizontalOffset="-220"
                 IsLightDismissEnabled="True">
            
            <Border x:Name="AutoPanel" Classes="topbar-popup">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="AutoAttackButton" Content="Attack" />
                  <Button x:Name="AutoHuntButton" Content="Hunt" />
                  <Button x:Name="AutoStopButton" Content="Stop" />
                </StackPanel>
                <TextBlock x:Name="AutoClassText" />
              </StackPanel>
            </Border>
            
          </Popup>

          <ToggleButton x:Name="JumpToggle" Classes="topbar-action flat" Content="Jump" />
          <Popup x:Name="JumpPopup"
                 IsOpen="{Binding IsChecked, ElementName=JumpToggle}"
                 Placement="Bottom"
                 PlacementTarget="{Binding ElementName=JumpToggle}"
                 HorizontalOffset="-185"
                 IsLightDismissEnabled="True">
            
            <Border x:Name="JumpPanel" Classes="topbar-popup">
              <StackPanel Spacing="8">
                <TextBox x:Name="JumpCellTextBox" Watermark="Cell" />
                <TextBox x:Name="JumpPadTextBox" Watermark="Pad" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="JumpCurrentButton" Content="Current" />
                  <Button x:Name="JumpRefreshButton" Content="Refresh" />
                  <Button x:Name="JumpGoButton" Content="Jump" />
                </StackPanel>
              </StackPanel>
            </Border>
            
          </Popup>

          <Button x:Name="BotWindowButton" Classes="topbar-action flat" Content="+" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Background="#000000" PointerEntered="NonMenuArea_PointerEntered">
        <!--<controls:WinFormsFlashHost x:Name="FlashHost" IsVisible="False" />-->
        <ProgressBar x:Name="LoadingBar"
                     Width="150"
                     Height="8"
                     IsIndeterminate="True"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
      </Grid>

      <Border Grid.Row="2"
              Background="{DynamicResource SkuaPageBrush}"
              BorderBrush="{DynamicResource SkuaNavHoverBrush}"
              BorderThickness="0,1,0,0"
              Padding="10,4">
        
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock x:Name="FpsMetricText" Text="FPS: --" />
          <TextBlock x:Name="WorkingSetMetricText" Text="RAM: --" />
          <TextBlock x:Name="PrivateMetricText" Text="Private: --" />
          <TextBlock x:Name="ManagedMetricText" Text="Managed: --" />
        </StackPanel>
      </Border>
    </Grid>
    
  </Grid>
  
</Window>
