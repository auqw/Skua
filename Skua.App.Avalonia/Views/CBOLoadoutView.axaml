<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.App.Avalonia.Views.CBOLoadoutView">
  <ScrollViewer
                Margin="4"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="4">
      <Border Classes="card"
              Padding="4">
        <ContentControl Content="{Binding ClassSelectViewModel}" />
      </Border>

      <Expander IsExpanded="False">
        <Expander.Header>
          <TextBlock
                     FontWeight="SemiBold"
                     Text="Equipment" />
        </Expander.Header>
        <Border Classes="card"
                Margin="0,4,0,0"
                Padding="4">
          <ContentControl Content="{Binding ClassEquipmentViewModel}" />
        </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
