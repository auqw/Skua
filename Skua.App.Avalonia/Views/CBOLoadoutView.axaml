<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.App.Avalonia.Views.CBOLoadoutView">
  <ScrollViewer
                Margin="8"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="8">
      <Border Padding="8"
              BorderThickness="1"
              BorderBrush="{DynamicResource SkuaNavHoverBrush}">
        <ContentControl Content="{Binding ClassSelectViewModel}" />
      </Border>

      <Expander IsExpanded="False">
        <Expander.Header>
          <TextBlock
                     FontWeight="SemiBold"
                     Text="Equipment" />
        </Expander.Header>
        <Border Margin="0,8,0,0"
                Padding="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource SkuaNavHoverBrush}">
          <ContentControl Content="{Binding ClassEquipmentViewModel}" />
        </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
