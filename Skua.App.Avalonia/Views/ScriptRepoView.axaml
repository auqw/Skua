<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.App.Avalonia.Views.ScriptRepoView">
  <Grid Margin="8"
        RowDefinitions="Auto,*,Auto,Auto">
    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,Auto,Auto,Auto,*"
          Margin="0,0,0,8">
      <Button Grid.Column="0"
              Content="Refresh"
              Command="{Binding RefreshScriptsCommand}" />
      <Button Grid.Column="1"
              Margin="8,0,0,0"
              Content="Download All"
              Command="{Binding DownloadAllCommand}" />
      <Button Grid.Column="2"
              Margin="8,0,0,0"
              Content="Update All"
              Command="{Binding UpdateAllCommand}" />
      <Button Grid.Column="3"
              Margin="8,0,0,0"
              Content="Open Scripts Folder"
              Command="{Binding OpenScriptFolderCommand}" />
    </Grid>

    <Grid Grid.Row="1"
          ColumnDefinitions="*,Auto"
          Margin="0,0,0,8">
      <Border Grid.Column="0"
              BorderThickness="1"
              BorderBrush="{DynamicResource SkuaNavHoverBrush}">
        <ListBox ItemsSource="{Binding Scripts}"
                 SelectedItem="{Binding SelectedItem}"
                 BorderThickness="0"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="8,6"
                          Spacing="4">
                <TextBlock Text="{Binding FileName}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Info.Description}"
                           Opacity="0.85"
                           TextWrapping="Wrap" />
                <TextBlock Opacity="0.7"
                           Text="{Binding ScriptPath, StringFormat='Path: {0}', TargetNullValue='Path: '}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <StackPanel Grid.Column="1"
                  Margin="8,0,0,0"
                  Spacing="8"
                  Width="120">
        <Button Content="Download"
                Command="{Binding DownloadCommand}" />
        <Button Content="Delete"
                Command="{Binding DeleteCommand}" />
        <Button Content="Open"
                Command="{Binding OpenScriptCommand}" />
        <Button Content="Cancel"
                Command="{Binding CancelTaskCommand}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2"
          ColumnDefinitions="Auto,Auto,Auto,Auto,*"
          Margin="0,0,0,6">
      <TextBlock Grid.Column="0"
                 Text="{Binding ScriptQuantity, StringFormat='Scripts: {0}'}" />
      <TextBlock Grid.Column="1"
                 Margin="12,0,0,0"
                 Text="{Binding DownloadedQuantity, StringFormat='Downloaded: {0}'}" />
      <TextBlock Grid.Column="2"
                 Margin="12,0,0,0"
                 Text="{Binding OutdatedQuantity, StringFormat='Outdated: {0}'}" />
      <TextBlock Grid.Column="3"
                 Margin="12,0,0,0"
                 Text="{Binding BotScriptQuantity, StringFormat='Local list: {0}'}" />
    </Grid>

    <TextBlock Grid.Row="3"
               Text="{Binding ProgressReportMessage}"
               Opacity="0.9" />
  </Grid>
</UserControl>
