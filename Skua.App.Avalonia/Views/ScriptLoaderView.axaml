<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Skua.App.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="450" d:DataContext="{d:DesignInstance viewModels:ScriptLoaderViewModel}"
             x:Class="Skua.App.Avalonia.Views.ScriptLoaderView">
    
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="3">
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Margin="0,0,0,3" FontSize="20" Text="{Binding ScriptStatus, StringFormat='Status: {0}', TargetNullValue='Status: '}" />
            <TextBlock Margin="0,3" Text="{Binding LoadedScript}" />
        </StackPanel>
        <Grid Grid.Row="1"
              Margin="0,3"
              RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnDefinitions="*,*">
            <Button Grid.Row="0" Grid.Column="0" Classes="skua-button" Margin="0,0,3,3" Content="Load Script" Command="{Binding LoadScriptCommand}" />
            <Button Grid.Row="0" Grid.Column="1" Classes="skua-button" Margin="3,0,0,3" Content="Open VSCode" Command="{Binding OpenVSCodeCommand}" />
            <Button Grid.Row="1" Grid.Column="0" Classes="skua-button" Margin="0,3,3,3" Content="Edit Script" Command="{Binding EditScriptCommand}" />
            <Button Grid.Row="1" Grid.Column="1" Classes="skua-button" Margin="3,3,0,3" Content="Search Scripts" Command="{Binding OpenScriptRepoCommand}" />
            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Classes="skua-button" Margin="0,3,0,3" Content="Edit Script Options" Command="{Binding EditScriptConfigCommand}" IsEnabled="{Binding ToggleScriptEnabled}" />
            <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Classes="skua-button" Margin="0,3,0,0" Content="Start/Stop Script" Command="{Binding ToggleScriptCommand}" IsEnabled="{Binding ToggleScriptEnabled}" />
        </Grid>
        <ContentControl Grid.Row="2"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SkuaAccentBrush}"
                        Content="{Binding ScriptLogs}" />
        <Button Grid.Row="3"
                Classes="skua-button"
                Margin="0,3,0,0"
                Content="Report Issues to @Tato2/@bogalj"
                Command="{Binding OpenBrowserFormCommand}" />
    </Grid>
</UserControl>
