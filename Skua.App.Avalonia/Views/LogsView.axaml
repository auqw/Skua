<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.App.Avalonia.Views.LogsView">
  <DockPanel Margin="8">
    <ListBox DockPanel.Dock="Top"
             ItemsSource="{Binding LogTabs}"
             SelectedItem="{Binding SelectedTab}"
             BorderThickness="0"
             Background="Transparent"
             Margin="0,0,0,8">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="8,4"
                  Margin="0,0,6,0"
                  Background="{DynamicResource SkuaNavHoverBrush}"
                  CornerRadius="4">
            <TextBlock Text="{Binding Title}" />
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <ContentControl Content="{Binding SelectedTab}" />
  </DockPanel>
</UserControl>
