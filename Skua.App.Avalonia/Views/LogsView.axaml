<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.App.Avalonia.Views.LogsView">
  
    <DockPanel>
        <ListBox DockPanel.Dock="Top"
                 ItemsSource="{Binding LogTabs}"
                 SelectedItem="{Binding SelectedTab}">
                        
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Width="60" TextAlignment="Center" Text="{Binding Title}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
                          
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <ContentControl Content="{Binding SelectedTab}" />
    </DockPanel>
</UserControl>
