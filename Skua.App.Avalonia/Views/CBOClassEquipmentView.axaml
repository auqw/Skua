<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.App.Avalonia.Views.CBOClassEquipmentView">
  <Grid RowDefinitions="Auto,Auto,Auto"
        ColumnDefinitions="*,*">
    <Button Grid.Row="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,8"
            Content="Refresh Inventory"
            Command="{Binding RefreshInventoryCommand}" />

    <Border Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,4,8"
            Padding="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource SkuaNavHoverBrush}">
      <StackPanel Spacing="6">
        <TextBlock Text="Solo Equipment" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding Helms}" SelectedItem="{Binding SelectedSoloHelm}" />
        <ComboBox ItemsSource="{Binding Armors}" SelectedItem="{Binding SelectedSoloArmor}" />
        <ComboBox ItemsSource="{Binding Capes}" SelectedItem="{Binding SelectedSoloCape}" />
        <ComboBox ItemsSource="{Binding Weapons}" SelectedItem="{Binding SelectedSoloWeapon}" />
        <ComboBox ItemsSource="{Binding Pets}" SelectedItem="{Binding SelectedSoloPet}" />
        <ComboBox ItemsSource="{Binding GroundItems}" SelectedItem="{Binding SelectedSoloGroundItem}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1"
            Grid.Column="1"
            Margin="4,0,0,8"
            Padding="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource SkuaNavHoverBrush}">
      <StackPanel Spacing="6">
        <TextBlock Text="Farm Equipment" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding Helms}" SelectedItem="{Binding SelectedFarmHelm}" />
        <ComboBox ItemsSource="{Binding Armors}" SelectedItem="{Binding SelectedFarmArmor}" />
        <ComboBox ItemsSource="{Binding Capes}" SelectedItem="{Binding SelectedFarmCape}" />
        <ComboBox ItemsSource="{Binding Weapons}" SelectedItem="{Binding SelectedFarmWeapon}" />
        <ComboBox ItemsSource="{Binding Pets}" SelectedItem="{Binding SelectedFarmPet}" />
        <ComboBox ItemsSource="{Binding GroundItems}" SelectedItem="{Binding SelectedFarmGroundItem}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2"
            Grid.Column="0"
            Margin="0,0,4,0"
            Padding="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource SkuaNavHoverBrush}">
      <StackPanel Spacing="6">
        <TextBlock Text="Dodge Equipment" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding Helms}" SelectedItem="{Binding SelectedDodgeHelm}" />
        <ComboBox ItemsSource="{Binding Armors}" SelectedItem="{Binding SelectedDodgeArmor}" />
        <ComboBox ItemsSource="{Binding Capes}" SelectedItem="{Binding SelectedDodgeCape}" />
        <ComboBox ItemsSource="{Binding Weapons}" SelectedItem="{Binding SelectedDodgeWeapon}" />
        <ComboBox ItemsSource="{Binding Pets}" SelectedItem="{Binding SelectedDodgePet}" />
        <ComboBox ItemsSource="{Binding GroundItems}" SelectedItem="{Binding SelectedDodgeGroundItem}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2"
            Grid.Column="1"
            Margin="4,0,0,0"
            Padding="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource SkuaNavHoverBrush}">
      <StackPanel Spacing="6">
        <TextBlock Text="Boss Equipment" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding Helms}" SelectedItem="{Binding SelectedBossHelm}" />
        <ComboBox ItemsSource="{Binding Armors}" SelectedItem="{Binding SelectedBossArmor}" />
        <ComboBox ItemsSource="{Binding Capes}" SelectedItem="{Binding SelectedBossCape}" />
        <ComboBox ItemsSource="{Binding Weapons}" SelectedItem="{Binding SelectedBossWeapon}" />
        <ComboBox ItemsSource="{Binding Pets}" SelectedItem="{Binding SelectedBossPet}" />
        <ComboBox ItemsSource="{Binding GroundItems}" SelectedItem="{Binding SelectedBossGroundItem}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
