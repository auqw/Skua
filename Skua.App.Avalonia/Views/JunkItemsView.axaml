<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.App.Avalonia.Views.JunkItemsView">
  <Grid Margin="8"
        RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Spacing="8"
                Margin="0,0,0,8">
      <Button Content="Refresh"
              Command="{Binding RefreshCommand}" />
      <Button Content="Mark Junk"
              Command="{Binding MarkAsJunkCommand}" />
      <Button Content="Unmark"
              Command="{Binding UnmarkAsJunkCommand}" />
      <Button Content="Unmark All"
              Command="{Binding UnmarkAllJunkCommand}" />
      <Button Content="Sell All"
              Command="{Binding SellAllJunkCommand}" />
    </StackPanel>

    <Border Grid.Row="1"
            Margin="0,0,0,8"
            BorderThickness="1"
            BorderBrush="{DynamicResource SkuaNavHoverBrush}">
      <ListBox ItemsSource="{Binding Items}"
               BorderThickness="0"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,Auto,*"
                  Margin="8,4">
              <CheckBox Grid.Column="0"
                        IsChecked="{Binding IsSelected}" />
              <CheckBox Grid.Column="1"
                        Margin="8,0,8,0"
                        IsChecked="{Binding IsJunk}" />
              <TextBlock Grid.Column="2"
                         VerticalAlignment="Center"
                         Text="{Binding Display}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                Spacing="16">
      <TextBlock Text="{Binding TotalJunk, StringFormat='Total junk: {0}'}" />
      <CheckBox IsChecked="{Binding SkipSellWarning}"
                Content="Skip sell warning" />
    </StackPanel>
  </Grid>
</UserControl>
