<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.App.Avalonia.Views.ConsoleView">
    
    <Grid RowDefinitions="*,Auto" Margin="4">
        <TextBox Grid.Row="0"
                 Text="{Binding SnippetText}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="320" />
        
        <Button Grid.Row="1"
                Classes="skua-button"
                Margin="0,4,0,0"
                HorizontalAlignment="Stretch"
                MinWidth="110"
                Content="Run"
                Command="{Binding RunCommand}" />
    </Grid>
</UserControl>
