<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.App.Avalonia.Views.ConsoleView">
  <Grid RowDefinitions="Auto,*,Auto"
        Margin="8">
    <TextBlock Grid.Row="0"
               Text="C# Snippet"
               FontWeight="SemiBold"
               Margin="0,0,0,6" />
    <TextBox Grid.Row="1"
             Text="{Binding SnippetText}"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             MinHeight="220" />
    <Button Grid.Row="2"
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            MinWidth="110"
            Content="Run"
            Command="{Binding RunCommand}" />
  </Grid>
</UserControl>
