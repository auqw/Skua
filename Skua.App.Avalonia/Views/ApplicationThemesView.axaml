<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cp="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
             x:Class="Skua.App.Avalonia.Views.ApplicationThemesView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8"
                Spacing="10">
      <Border Padding="8"
              BorderBrush="{DynamicResource SkuaNavHoverBrush}"
              BorderThickness="1"
              Background="{DynamicResource SkuaPageBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0"
                   Margin="0,0,8,0"
                   Watermark="Theme Name"
                   Text="{Binding ThemeSettings.ThemeName, Mode=TwoWay}" />
          <Button Grid.Column="1"
                  Content="Save"
                  Command="{Binding ThemeSettings.SaveThemeCommand}" />
        </Grid>
      </Border>

      <Border Padding="8"
              BorderBrush="{DynamicResource SkuaNavHoverBrush}"
              BorderThickness="1"
              Background="{DynamicResource SkuaPageBrush}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold"
                     Text="Accent" />
          <Grid ColumnDefinitions="220,1,*">
            <StackPanel Grid.Column="0"
                        Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Dark Mode" />
                <ToggleSwitch Grid.Column="1"
                              VerticalAlignment="Center"
                              OnContent=""
                              OffContent=""
                              IsChecked="{Binding ThemeService.IsDarkTheme}" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Color Adjustment" />
                <ToggleSwitch x:Name="ColorAdjustToggle"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              OnContent=""
                              OffContent=""
                              IsChecked="{Binding ThemeService.IsColorAdjusted}" />
              </Grid>

              <Border Margin="0,2,0,2"
                      Height="1"
                      Background="{DynamicResource SkuaNavHoverBrush}" />

              <StackPanel IsVisible="{Binding #ColorAdjustToggle.IsChecked}"
                          Spacing="6">
                <TextBlock FontWeight="SemiBold"
                           Text="Advanced Color Adjustment" />
                <TextBlock Margin="0,2,0,0"
                           Text="Desired Contrast Ratio" />
                <Grid ColumnDefinitions="*,Auto">
                  <Slider x:Name="ContrastRatioSlider"
                          Grid.Column="0"
                          Margin="0,0,8,0"
                          Minimum="1"
                          Maximum="21"
                          TickFrequency="0.1"
                          IsSnapToTickEnabled="True"
                          Value="{Binding ThemeService.DesiredContrastRatio}" />
                  <TextBlock Grid.Column="1"
                             Width="54"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Text="{Binding #ContrastRatioSlider.Value, StringFormat={}{0:0.0}:1}" />
                </Grid>

                <TextBlock Margin="0,2,0,0"
                           Text="Contrast" />
                <ComboBox ItemsSource="{Binding ThemeService.ContrastValues}"
                          SelectedItem="{Binding ThemeService.ContrastValue}" />
              </StackPanel>
            </StackPanel>

            <Border Grid.Column="1"
                    Margin="8,0"
                    Width="1"
                    Background="{DynamicResource SkuaNavHoverBrush}" />

            <Grid Grid.Column="2"
                  Margin="10,0,0,0"
                  RowDefinitions="Auto,*">
              <TextBlock Text="Custom Picker" />
              <cp:ColorView x:Name="AccentColorView"
                            Grid.Row="1"
                            Color="{Binding ThemeService.SelectedColor, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            MinHeight="340"
                            Height="380"
                            IsAccentColorsVisible="True"
                            IsAlphaVisible="True"
                            IsColorPaletteVisible="True"
                            IsColorComponentsVisible="True"
                            IsComponentSliderVisible="True"
                            IsComponentTextInputVisible="True"
                            IsColorModelVisible="True"
                            IsColorSpectrumVisible="True"
                            IsColorSpectrumSliderVisible="True"
                            IsHexInputVisible="True" />
            </Grid>
          </Grid>
        </StackPanel>
      </Border>

      <Border Padding="8"
              BorderBrush="{DynamicResource SkuaNavHoverBrush}"
              BorderThickness="1"
              Background="{DynamicResource SkuaPageBrush}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold"
                     Text="Scheme Target" />
          <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0"
                    Margin="0,0,4,0"
                    Padding="0"
                    MinHeight="150"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Command="{Binding ColorSchemeEditor.ChangeToPrimaryCommand}">
              <Grid RowDefinitions="Auto,*"
                    Margin="10,8">
                <TextBlock Margin="0,0,0,6"
                           HorizontalAlignment="Left"
                           Text="Primary" />
                <Border Grid.Row="1"
                        Height="108"
                        BorderBrush="{DynamicResource SkuaNavHoverBrush}"
                        BorderThickness="1"
                        Padding="8,12"
                        Background="{DynamicResource SkuaAccentBrush}">
                  <TextBlock Text="{Binding ThemeService.SelectedColor, TargetNullValue='(none)'}"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource SkuaAccentForegroundBrush}" />
                </Border>
              </Grid>
            </Button>

            <Button Grid.Column="1"
                    Margin="4,0,0,0"
                    Padding="0"
                    MinHeight="150"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Command="{Binding ColorSchemeEditor.ChangeToPrimaryForegroundCommand}">
              <Grid RowDefinitions="Auto,*"
                    Margin="10,8">
                <TextBlock Margin="0,0,0,6"
                           HorizontalAlignment="Left"
                           Text="Text on Primary" />
                <Border Grid.Row="1"
                        Height="108"
                        BorderBrush="{DynamicResource SkuaNavHoverBrush}"
                        BorderThickness="1"
                        Padding="8,12"
                        Background="{DynamicResource SkuaAccentBrush}">
                  <TextBlock Text="Text"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource SkuaAccentForegroundBrush}" />
                </Border>
              </Grid>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <Border Padding="8"
              BorderBrush="{DynamicResource SkuaNavHoverBrush}"
              BorderThickness="1"
              Background="{DynamicResource SkuaPageBrush}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold"
                     Text="Theme Library" />

          <TextBlock Text="Presets"
                     Opacity="0.8" />
          <ItemsControl ItemsSource="{Binding ThemeService.Presets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="3"
                        Command="{Binding DataContext.SetCurrentThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Margin="0,4,0,0"
                     Text="User Themes"
                     Opacity="0.8" />
          <ItemsControl ItemsSource="{Binding ThemeService.UserThemes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="3"
                      ColumnDefinitions="*,Auto">
                  <Button Grid.Column="0"
                          Command="{Binding DataContext.SetCurrentThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          Content="{Binding}" />
                  <Button Grid.Column="1"
                          Width="34"
                          Margin="4,0,0,0"
                          Command="{Binding DataContext.RemoveThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          Content="X" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Expander IsExpanded="False">
        <Expander.Header>
          <TextBlock FontWeight="SemiBold"
                     Text="Backgrounds" />
        </Expander.Header>
        <Border Margin="0,8,0,0"
                Padding="4"
                BorderBrush="{DynamicResource SkuaNavHoverBrush}"
                BorderThickness="1"
                Background="{DynamicResource SkuaPageBrush}">
          <Grid DataContext="{Binding BackgroundTheme}"
                ColumnDefinitions="*,Auto,Auto"
                RowDefinitions="Auto,Auto">
            <ComboBox Grid.Row="0"
                      Grid.Column="0"
                      Margin="3"
                      ItemsSource="{Binding AvailableBackgrounds}"
                      SelectedItem="{Binding SelectedBackground}" />
            <Button Grid.Row="0"
                    Grid.Column="1"
                    Margin="3"
                    Content="Browse"
                    Command="{Binding BrowseBackgroundCommand}" />
            <Button Grid.Row="0"
                    Grid.Column="2"
                    Margin="3"
                    Content="Refresh"
                    Command="{Binding RefreshBackgroundsCommand}" />

            <Button Grid.Row="1"
                    Grid.Column="0"
                    Margin="3"
                    Content="Open Themes Folder"
                    Command="{Binding OpenThemesFolderCommand}" />
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="3"
                    Content="Get Backgrounds"
                    Command="{Binding GetBackgroundsCommand}" />
          </Grid>
        </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
