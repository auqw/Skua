<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.App.Avalonia.Views.RuntimeHelpersView">
  <TabControl Margin="8">
    <TabItem Header="Drops">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0"
              DataContext="{Binding ToPickupDropsViewModel}"
              ColumnDefinitions="Auto,Auto,*">
          <Button Grid.Column="0"
                  Classes="skua-button"
                  Content="Toggle"
                  Command="{Binding ToggleDropsCommand}" />
          <Button Grid.Column="1"
                  Classes="skua-button gap-left-8"
                  Content="Notify"
                  Command="{Binding OpenNotifyDropCommand}" />
        </Grid>

        <Grid Grid.Row="1"
              DataContext="{Binding ToPickupDropsViewModel}"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,8,0,0">
          <TextBox Grid.Column="0"
                   Watermark="Add items separated by |"
                   Text="{Binding AddDropInput}" />
          <Button Grid.Column="1"
                  Classes="skua-button gap-left-8"
                  Content="Add"
                  Command="{Binding AddDropCommand}" />
          <Button Grid.Column="2"
                  Classes="skua-button gap-left-8"
                  Content="Clear"
                  Command="{Binding RemoveAllDropsCommand}" />
        </Grid>

        <Border Grid.Row="2"
                DataContext="{Binding ToPickupDropsViewModel}"
                Margin="0,8,0,0"
                Classes="list-frame">
          <ListBox x:Name="DropList"
                   ItemsSource="{Binding ToPickup}"
                   SelectionMode="Multiple"
                   Classes="embedded" />
        </Border>

        <Button Grid.Row="3"
                Classes="skua-button"
                DataContext="{Binding ToPickupDropsViewModel}"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                Content="Remove Selected"
                Click="RemoveSelectedDrops_Click" />
      </Grid>
    </TabItem>

    <TabItem Header="Quests">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0"
              DataContext="{Binding RegisteredQuestsViewModel}"
              ColumnDefinitions="*,120,Auto"
              Margin="0,0,0,8">
          <TextBox Grid.Column="0"
                   Watermark="Quest IDs (| , space)"
                   Text="{Binding AddQuestInput}" />
          <TextBox Grid.Column="1"
                   Classes="gap-left-8"
                   Watermark="Reward ID"
                   Text="{Binding RewardIdInput}" />
          <Button Grid.Column="2"
                  Classes="skua-button gap-left-8"
                  Content="Add"
                  Command="{Binding AddQuestCommand}" />
        </Grid>

        <Border Grid.Row="1"
                DataContext="{Binding RegisteredQuestsViewModel}"
                Classes="list-frame">
          <ListBox x:Name="QuestRegList"
                   ItemsSource="{Binding CurrentAutoQuests}"
                   SelectionMode="Multiple"
                   Classes="embedded" />
        </Border>

        <Grid Grid.Row="2"
              DataContext="{Binding RegisteredQuestsViewModel}"
              ColumnDefinitions="Auto,Auto,*"
              Margin="0,8,0,0">
          <Button Grid.Column="0"
                  Classes="skua-button"
                  Content="Remove Selected"
                  Click="RemoveSelectedQuests_Click" />
          <Button Grid.Column="1"
                  Classes="skua-button gap-left-8"
                  Content="Clear All"
                  Command="{Binding RemoveAllQuestsCommand}" />
        </Grid>
      </Grid>
    </TabItem>

    <TabItem Header="Boosts">
      <StackPanel Margin="8"
                  Spacing="8"
                  DataContext="{Binding BoostsViewModel}">
        <Button Classes="skua-button"
                Content="Toggle Boosts"
                Command="{Binding ToggleBoostsCommand}" />
        <Button Classes="skua-button"
                Content="Find Boost IDs (Inventory)"
                Click="BoostIdsInventory_Click" />
        <Button Classes="skua-button"
                Content="Find Boost IDs (Include Bank)"
                Click="BoostIdsBank_Click" />
      </StackPanel>
    </TabItem>
  </TabControl>
</UserControl>


