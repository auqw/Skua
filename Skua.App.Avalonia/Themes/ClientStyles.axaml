<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <Color x:Key="SkuaAccentColor">#C9479A</Color>
      <Color x:Key="SkuaAccentForegroundColor">#FFFFFFFF</Color>
      <SolidColorBrush x:Key="SkuaAccentBrush" Color="{StaticResource SkuaAccentColor}" />
      <SolidColorBrush x:Key="SkuaAccentForegroundBrush" Color="{StaticResource SkuaAccentForegroundColor}" />

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SkuaPageBrush" Color="#ECEEF2" />
          <SolidColorBrush x:Key="SkuaNavHoverBrush" Color="#DDE2EA" />
          <SolidColorBrush x:Key="SkuaTextBrush" Color="#1E222B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SkuaPageBrush" Color="#242830" />
          <SolidColorBrush x:Key="SkuaNavHoverBrush" Color="#3D4552" />
          <SolidColorBrush x:Key="SkuaTextBrush" Color="#E8ECF3" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource SkuaPageBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Menu.top-toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="MenuItem.top-nav-item">
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="MenuItem.top-nav-item /template/ Border#PART_Presenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:pointerover /template/ Border#PART_Presenter">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:selected">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:selected /template/ Border#PART_Presenter">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:submenuopen">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:submenuopen /template/ Border#PART_Presenter">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
  </Style>

  <Style Selector="MenuItem.top-nav-item:submenuopen /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Button.topbar-action">
    <Setter Property="Height" Value="25" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.topbar-action:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.topbar-action">
    <Setter Property="Height" Value="25" />
    <Setter Property="MinWidth" Value="50" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ToggleButton.topbar-action:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.topbar-action:checked">
    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
  </Style>

  <Style Selector="Border.topbar-popup">
    <Setter Property="MinWidth" Value="280" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Background" Value="{DynamicResource SkuaPageBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkuaNavHoverBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
</Styles>
