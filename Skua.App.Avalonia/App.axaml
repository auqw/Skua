<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             xmlns:vms="clr-namespace:Skua.Core.ViewModels;assembly=Skua.Core"
             xmlns:views="clr-namespace:Skua.App.Avalonia.Views"
             xmlns:uc="clr-namespace:Skua.App.Avalonia.UserControls"
             x:Class="Skua.App.Avalonia.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <fluent:ColorPaletteResources x:Key="Light" Accent="#C9479A" />
        <fluent:ColorPaletteResources x:Key="Dark" Accent="#C9479A" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="/Themes/ClientStyles.axaml" />
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/SkuaIcon.ico"
                ToolTipText="Skua"
                Clicked="TrayIcon_Clicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Show Client" Click="TrayShowClient_Click" />
            <NativeMenuItem Header="Hide Client" Click="TrayHideClient_Click" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Exit" Click="TrayExit_Click" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
  <Application.DataTemplates>
    <DataTemplate DataType="vms:BotWindowViewModel">
      <Grid ColumnDefinitions="210,*"
            RowDefinitions="*"
            Margin="8">
        <Border Grid.Column="0"
                Margin="0,0,8,0"
                Padding="6"
                Background="{DynamicResource SkuaPageBrush}"
                BorderBrush="{DynamicResource SkuaNavHoverBrush}"
                BorderThickness="1">
          <ListBox ItemsSource="{Binding BotViews}"
                   SelectedItem="{Binding SelectedItem}"
                   BorderThickness="0"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Title}" Margin="6,4" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <Border Grid.Column="1"
                Padding="8"
                Background="{DynamicResource SkuaPageBrush}"
                BorderBrush="{DynamicResource SkuaNavHoverBrush}"
                BorderThickness="1">
          <ContentControl Content="{Binding SelectedItem}" />
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vms:ScriptLoaderViewModel">
      <views:ScriptLoaderView />
    </DataTemplate>
    <DataTemplate DataType="vms:ScriptRepoViewModel">
      <views:ScriptRepoView />
    </DataTemplate>
    <DataTemplate DataType="vms:PluginsViewModel">
      <views:PluginsView />
    </DataTemplate>
    <DataTemplate DataType="vms:LoaderViewModel">
      <views:LoaderView />
    </DataTemplate>
    <DataTemplate DataType="vms:GrabberViewModel">
      <views:GrabberView />
    </DataTemplate>
    <DataTemplate DataType="vms:RuntimeHelpersViewModel">
      <views:RuntimeHelpersView />
    </DataTemplate>
    <DataTemplate DataType="vms:NotifyDropViewModel">
      <views:NotifyDropView />
    </DataTemplate>
    <DataTemplate DataType="vms:FastTravelViewModel">
      <views:FastTravelView />
    </DataTemplate>
    <DataTemplate DataType="vms:CurrentDropsViewModel">
      <views:CurrentDropsView />
    </DataTemplate>
    <DataTemplate DataType="vms:JunkItemsViewModel">
      <views:JunkItemsView />
    </DataTemplate>
    <DataTemplate DataType="vms:ConsoleViewModel">
      <views:ConsoleView />
    </DataTemplate>
    <DataTemplate DataType="vms:ScriptStatsViewModel">
      <views:ScriptStatsView />
    </DataTemplate>
    <DataTemplate DataType="vms:AdvancedSkillsViewModel">
      <views:AdvancedSkillsView />
    </DataTemplate>
    <DataTemplate DataType="vms:PacketSpammerViewModel">
      <views:PacketSpammerView />
    </DataTemplate>
    <DataTemplate DataType="vms:PacketLoggerViewModel">
      <views:PacketLoggerView />
    </DataTemplate>
    <DataTemplate DataType="vms:PacketInterceptorViewModel">
      <views:PacketInterceptorView />
    </DataTemplate>
    <DataTemplate DataType="vms:GameOptionsViewModel">
      <views:GameOptionsView />
    </DataTemplate>
    <DataTemplate DataType="vms:ApplicationOptionsViewModel">
      <views:ApplicationOptionsView />
    </DataTemplate>
    <DataTemplate DataType="vms:CoreBotsViewModel">
      <views:CoreBotsView />
    </DataTemplate>
    <DataTemplate DataType="vms:CBOLoadoutViewModel">
      <views:CBOLoadoutView />
    </DataTemplate>
    <DataTemplate DataType="vms:CBOClassSelectViewModel">
      <views:CBOClassSelectView />
    </DataTemplate>
    <DataTemplate DataType="vms:CBOClassEquipmentViewModel">
      <views:CBOClassEquipmentView />
    </DataTemplate>
    <DataTemplate DataType="vms:CBOptionsViewModel">
      <views:CBOptionsView />
    </DataTemplate>
    <DataTemplate DataType="vms:CBOOtherOptionsViewModel">
      <views:CBOOtherOptionsView />
    </DataTemplate>
    <DataTemplate DataType="vms:ApplicationThemesViewModel">
      <views:ApplicationThemesView />
    </DataTemplate>
    <DataTemplate DataType="vms:HotKeysViewModel">
      <views:HotKeysView />
    </DataTemplate>
    <DataTemplate DataType="vms:LogsViewModel">
      <views:LogsView />
    </DataTemplate>
    <DataTemplate DataType="vms:LogTabViewModel">
      <uc:LogTabUserControl />
    </DataTemplate>
    <DataTemplate DataType="vms:BotControlViewModelBase">
      <Border Padding="10"
              Background="{DynamicResource SkuaPageBrush}"
              BorderBrush="{DynamicResource SkuaNavHoverBrush}"
              BorderThickness="1">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
      </Border>
    </DataTemplate>
  </Application.DataTemplates>
</Application>
