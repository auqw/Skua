<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.App.Avalonia.UserControls.LogTabUserControl">
  <Grid RowDefinitions="*,Auto"
        Margin="0">
    <ListBox Grid.Row="0"
             ItemsSource="{Binding Logs}" />
    <Grid Grid.Row="1"
          Margin="0,8,0,0"
          ColumnDefinitions="*,*,*">
      <Button Grid.Column="0" Margin="0,0,4,0" Content="Clear" Command="{Binding ClearLogCommand}" />
      <Button Grid.Column="1" Margin="4,0,4,0" Content="Copy" Command="{Binding CopyLogCommand}" />
      <Button Grid.Column="2" Margin="4,0,0,0" Content="Save" Command="{Binding SaveLogCommand}" />
    </Grid>
  </Grid>
</UserControl>
